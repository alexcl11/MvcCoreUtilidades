<h1>
    Send Mail Net Core
</h1>

<form method="post">
    <label>To: </label>
    <input type="text" name="to" class="form-control"/>
    <label>Asunto: </label>
    <input type="text" name="asunto" class="form-control" />
    <label>Mensaje: </label>
    <textarea type="text" name="mensaje" class="form-control"></textarea>
    <button class="btn btn-success">
        Send email
    </button>
</form>

<h2>@ViewData["MENSAJE"]</h2>