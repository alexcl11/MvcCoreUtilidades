@model Coche

<ul class="list-group">
    <li class="list-group-item">ID: @Model.IdCoche</li>
    <li class="list-group-item">Marca: @Model.Marca</li>
    <li class="list-group-item">Modelo: @Model.Modelo</li>
    <div>
        <img src="@Model.Imagen" style="width: 100px; height: auto" />
    </div>
</ul>