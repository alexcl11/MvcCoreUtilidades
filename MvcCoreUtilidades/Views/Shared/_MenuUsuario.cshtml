@{
    string usuario = Context.Session.GetString("USUARIO");
}

@if (usuario == null)
{

    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Home" asp-action="LogIn">Log In</a>
    </li>
}
else
{

    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Perfil">Perfil @usuario</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-danger" asp-area="" asp-controller="Home" asp-action="LogOut">Cerrar Sesión @usuario</a>
    </li>

    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Pedidos">Pedidos</a>
    </li>
}