<h1>Cifrado Básico</h1>

<form method="post">
    <label>Contenido a cifrar: </label>
    <input type="text" name="contenido" class="form-control" />
    <label>Resultado cifrado: </label>
    <textarea rows="5" name="resultado" class="form-control">@ViewData["TEXTOCIFRADO"]</textarea>
    <button class="btn btn-success" name="accion" value="cifrar">
        Cifrar contenido
    </button>
    <button class="btn btn-info" name="accion" value="comparar">
        Comparar contenido
    </button>
</form>
<h2>@ViewData["MENSAJE"]</h2>